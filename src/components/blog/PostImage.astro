---
import PostImageZoom from '~/components/react/PostImageZoom';

export interface Props {
  src: string;
  alt?: string;
  width?: number | string;
  align?: 'left' | 'center' | 'right';
  rounded?: boolean;
  shadow?: boolean;
}

const {
  src,
  alt = '',
  width = 640,
  align = 'center',
  rounded = true,
  shadow = true,
} = Astro.props;

const maxWidth = typeof width === 'number' ? `${width}px` : width;

const alignmentClass = {
  left: 'mr-auto text-left',
  center: 'mx-auto text-center',
  right: 'ml-auto text-right',
}[align] || 'mx-auto text-center';

const figureStyle = `max-width:${maxWidth}; width:100%;`;
const reactStyle = { maxWidth, width: '100%', marginTop: '0.5rem', marginBottom: '0.3rem', fontWeight: 'bold' }; 
const baseClass = `w-full transition-transform duration-200 ease-out ${rounded ? 'rounded-xl' : ''} ${
  shadow ? 'shadow-lg' : ''
}`;

---

<figure class={`my-8 flex flex-col gap-2 ${alignmentClass}`} style={figureStyle}>
  <PostImageZoom
    client:load
    src={src}
    alt={alt}
    className={`${baseClass}`}
    style={reactStyle}
  />
  
  {Astro.slots.has('caption') && (
    <figcaption class="text-sm text-muted dark:text-slate-400" style="margin-top: 0">
      <slot name="caption" />
    </figcaption>
  )}
</figure>
